{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: core plugins plus every app command, both for the local start page and for the Prisma mirror loaded from a remote URL",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://*/*",
      "https://*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "allow-media-audio-probe",
    "allow-media-audio-start",
    "allow-media-audio-read",
    "allow-media-audio-stop",
    "core:default",
    "opener:default",
    "updater:default",
    "allow-get-app-version",
    "allow-app-installation-info",
    "allow-app-check-update",
    "allow-app-install-update",
    "allow-store-get",
    "allow-store-set",
    "allow-store-has",
    "allow-store-delete",
    "allow-store-all",
    "allow-toggle-fullscreen",
    "allow-close-app",
    "allow-load-url",
    "allow-mirror-state",
    "allow-mirror-check",
    "allow-mirror-apply",
    "allow-proxy-status",
    "allow-proxy-restart",
    "allow-fs-exists-sync",
    "allow-child-process-spawn",
    "allow-open-folder",
    "allow-open-external-url",
    "allow-find-player",
    "allow-player-detect",
    "allow-player-choose-path",
    "allow-player-validate",
    "allow-player-start",
    "allow-player-read-state",
    "allow-player-seek",
    "allow-export-settings-to-file",
    "allow-import-settings-from-file",
    "allow-torrserver-start",
    "allow-torrserver-stop",
    "allow-torrserver-restart",
    "allow-torrserver-status",
    "allow-torrserver-download",
    "allow-torrserver-check-update",
    "allow-torrserver-update",
    "allow-torrserver-uninstall",
    "allow-torrserver-is-installed"
  ]
}
