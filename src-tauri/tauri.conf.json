{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prisma",
  "version": "../package.json",
  "identifier": "com.prisma.desktop",
  "build": {
    "beforeDevCommand": "node scripts/prepare-media-tools.mjs",
    "beforeBuildCommand": "node scripts/prepare-media-tools.mjs",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prisma",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "url": "index.html",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "externalBin": ["binaries/prisma-ffmpeg", "binaries/prisma-ffprobe"],
    "resources": {
      "resources/media-tools/": "media-tools/"
    },
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "macos-info.plist",
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-gl"
        ]
      },
      "rpm": {
        "recommends": [
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzMUFFMkRDMTVBNjM2QkQKUldTOU5xWVYzT0lhd3k3dkFjMkdHZG1SZlNzZnZTS1g4WTYvTmFldkY3WnBUYlZSdEVWeVkrKzEK",
      "endpoints": [
        "https://github.com/Sheinices/prisma-desk/releases/latest/download/latest.json"
      ]
    }
  }
}
